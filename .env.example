# RADIUS local development defaults. Copy to .env for private overrides.
APP_ENV=development
APP_URL=http://localhost:3000
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=radius
DB_USER=root
DB_PASSWORD=
DB_SSL_MODE=DISABLED
DB_SSL_CA=
# Production platforms may provide the CA certificate as DB_SSL_CA_PEM;
# run.sh writes it to a temporary file and exports DB_SSL_CA.
DB_SSL_CA_PEM=

AI_SERVICE_URL=http://127.0.0.1:8001
# Optional secondary market-price evidence. The required RandomForest model
# remains the primary price anomaly model even when this is configured.
SERPAPI_KEY=

MAX_UPLOAD_MB=5
DEFAULT_RADIUS_KM=5

# Never commit real credentials to .env or this file.
