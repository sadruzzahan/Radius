# RADIUS local development defaults
#
# A fresh clone automatically loads this file when no private .env exists.
# These values match a standard local Windows setup with MySQL on port 3306,
# root as the local development user, and no root password.
#
# For deployment or a password-protected local MySQL account, create a private
# .env file with overrides. Never commit real passwords or API keys.

APP_ENV=development
APP_URL=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=radius
DB_USER=root
DB_PASSWORD=

AI_SERVICE_URL=http://127.0.0.1:8001

MAX_UPLOAD_MB=5
DEFAULT_RADIUS_KM=5
