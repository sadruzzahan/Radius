# RADIUS local development defaults
#
# This file is intentionally tracked and is automatically loaded when no private
# .env exists. The active values below match the new PHP + MySQL rewrite and the
# local MySQL setup currently being used on Windows.
#
# IMPORTANT: the previous Node/Supabase .env contained credentials that were
# committed to Git history. Those secret values are intentionally NOT copied here.
# Rotate/revoke those old credentials rather than recommitting them.

APP_ENV=development
APP_URL=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=radius
DB_USER=root
DB_PASSWORD=

AI_SERVICE_URL=http://127.0.0.1:8001

MAX_UPLOAD_MB=5
DEFAULT_RADIUS_KM=5

# Compatible non-secret values carried over from the old project configuration.
# These are retained only for convenience/reference; the PHP app does not depend
# on the old Node/Supabase architecture.
PORT=4000
CLIENT_ORIGIN=http://127.0.0.1:5000
ML_SERVICE_URL=http://127.0.0.1:8001
USE_MEMORY_STORE=false
SUPABASE_STORAGE_BUCKET=listing-photos
SUPABASE_URL=https://eowhnrcoqcvtyobbinhl.supabase.co

# Old secrets are deliberately omitted:
# JWT_SECRET=
# DATABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
